generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String
  name                String?
  
  // Kolom batas aman saldo
  saldoLimit          Int       @default(0)

  resetPasswordToken  String?   @unique // Token unik
  resetPasswordExpires DateTime? // Batas waktu token (misal 1 jam)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  // RELASI TABEL
  transactions        Transaction[]
  goals               Goal[]

  // --- TURBO MODE: Tambahkan Index ---
  // Agar login dan pengecekan profil super cepat
  @@index([email])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // INCOME / EXPENSE
  amount      Int
  category    String
  description String
  date        DateTime
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  // --- TURBO MODE: Tambahkan Index ---
  // 1. Agar semua transaksi milik user tertentu bisa diambil instan
  @@index([userId])
  
  // 2. Agar Grafik Dashboard (yang butuh filter tanggal) tidak lemot
  @@index([userId, date])
  
  // 3. Agar pemisahan Pemasukan/Pengeluaran instan
  @@index([userId, type])
}

model Goal {
  id            Int      @id @default(autoincrement())
  name          String
  targetAmount  Int
  currentAmount Int      @default(0)
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  // --- TURBO MODE: Tambahkan Index ---
  // Agar list target tabungan muncul cepat
  @@index([userId])
}